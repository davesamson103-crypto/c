#include <stdio.h>

int main() {
    double num1, num2, result;
    char operator;
    
    // Take input from the user
    printf("Enter the first number: ");
    scanf("%lf", &num1);
    
    printf("Enter an operator (+, -, *, /): ");
    scanf(" %c", &operator);  // space before %c to consume any leftover whitespace
    
    printf("Enter the second number: ");
    scanf("%lf", &num2);
    
    // Calculation based on the operator
    if (operator == '+') {
        result = num1 + num2;
        printf("%.3lf\n", result);
    } else if (operator == '-') {
        result = num1 - num2;
        printf("%.3lf\n", result);
    } else if (operator == '*') {
        result = num1 * num2;
        printf("%.3lf\n", result);
    } else if (operator == '/') {
        if (num2 != 0) {
            result = num1 / num2;
            printf("%.3lf\n", result);
        } else {
            printf("Error: Division by zero is not allowed\n");
        }
    } else {
        printf("%c is not a valid operator\n", operator);
    }

    return 0;
}
